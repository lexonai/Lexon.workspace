# Lexon Office server (npm run server). Office has NO password: it opens only from Lexon Workspace.
OFFICE_SSO_SECRET=            # REQUIRED, 24+ random chars. Enter the SAME value in Workspace > Integrations > Lexon Office > Link Office
OFFICE_GATEWAY_SECRET=        # same value as OFFICE_GATEWAY_SECRET in the Workspace Supabase secrets (lets Office pull the central AI keys)
WORKSPACE_FUNCTIONS_URL=      # https://<workspace-project-ref>.supabase.co/functions/v1
OFFICE_FRAME_ANCESTORS=       # your Workspace web origin, e.g. https://workspace.example.com (allows Office inside Workspace)
# PORT=8787   OFFICE_DATA=./data   OFFICE_BASE_PATH=