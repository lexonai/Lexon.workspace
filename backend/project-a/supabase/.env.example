# Project A Edge Function secrets. Copy to supabase/.env, fill, then: supabase secrets set --env-file supabase/.env
# NEVER commit the filled file.
ALLOWED_ORIGINS=https://workspace.example.com,https://team.example.com,lexon://app,http://localhost:5173,http://localhost:5174
APP_URL=https://workspace.example.com
TEAM_APP_URL=https://team.example.com
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shared secret that lets the Office project's server call the office-ai function. Set the SAME value in the Office project's secrets.
OFFICE_GATEWAY_SECRET=   # long random; ALSO set as OFFICE_GATEWAY_SECRET on the Office server (it pulls the central AI keys with it)

# ---- v5 ----
# Optional: email the Team link to invited people (https://resend.com). Without these, the Add Member screen still shows the link + code to share yourself.
RESEND_API_KEY=
MAIL_FROM=Lexon <team@your-domain.com>
# true = also put the invitation code inside the email. Default (unset/false) = code is shared separately, which is safer.
EMAIL_INCLUDE_CODE=false

# ---- v5 ----
# Optional: invitation emails through Resend (https://resend.com). Without these the Admin just copies the link + code.
RESEND_API_KEY=
MAIL_FROM=Lexon <team@your-domain.com>
# false (default): the email carries only the Team link; the Admin shares the code on another channel (safer).
EMAIL_INCLUDE_CODE=false
# NOTE: SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into every Edge Function by Supabase. Do not set them.
